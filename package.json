{
  "name": "icar-gezina",
  "version": "0.1.1",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build --concurrency=1",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "dev:web": "pnpm --filter @icar-gezina/web dev",
    "dev:admin": "pnpm --filter @icar-gezina/admin dev",
    "build:web": "pnpm --filter @icar-gezina/web build",
    "build:admin": "pnpm --filter @icar-gezina/admin build",
    "lint:web": "pnpm --filter @icar-gezina/web lint",
    "lint:admin": "pnpm --filter @icar-gezina/admin lint",
    "typecheck:web": "pnpm --filter @icar-gezina/web typecheck",
    "typecheck:admin": "pnpm --filter @icar-gezina/admin typecheck"
  },
  "devDependencies": {
    "turbo": "^2.5.6"
  }
}
